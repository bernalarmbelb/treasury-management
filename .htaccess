# =====================================================================
# Root .htaccess for Hostinger shared hosting (Apache / LiteSpeed)
# ---------------------------------------------------------------------
# This lets you upload the ENTIRE Laravel app into public_html/ and have
# the site served from the public/ folder, WITHOUT changing the document
# root or editing index.php.
#
# It also blocks direct web access to sensitive files (.env, etc.).
#
# Cleaner alternative (if your plan allows it): in hPanel set the website
# document root to public_html/public and you can delete this file.
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (remove these 2 lines if SSL is not active yet)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Send all requests into the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to dotfiles and sensitive project files
<FilesMatch "^\.env|^\.env\..*|composer\.(json|lock)|package(-lock)?\.json|artisan|\.gitignore|\.gitattributes">
    Require all denied
</FilesMatch>

# Block access to sensitive directories if requested directly
RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/.*$

Options -Indexes
