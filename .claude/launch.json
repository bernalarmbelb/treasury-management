{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "treasury-management",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const http=require('http'); http.createServer((req,res)=>{const preq=http.request({host:'treasury-management.test',port:80,path:req.url,method:req.method,headers:Object.assign({},req.headers,{host:'treasury-management.test'})},pres=>{res.writeHead(pres.statusCode,pres.headers);pres.pipe(res);});req.pipe(preq);}).listen(8123);"],
      "port": 8123,
      "autoPort": false,
      "url": "http://treasury-management.test/collections/transaction-entry"
    }
  ]
}
